# Copy to .env. Use a unique domain if other ROS applications run on this PC.
ROS_DOMAIN_ID=77
MODEL_DIR=./models
CPU_THREADS=4
INFERENCE_MEMORY=3g
SIMULATION_MEMORY=1536m
APPLICATION_MEMORY=768m
WEB_PORT=8000

# Official TurtleBot 4 warehouse (default), or the original small workshop.
SIM_SCENE=warehouse

# NVIDIA GPU inference only; CPU mode ignores this setting.
GPU_LAYERS=999

# First CUDA compilation: keep low on an 8 GB host.
GPU_BUILD_JOBS=2
