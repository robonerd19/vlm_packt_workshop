<?xml version="1.0"?>
<!-- Compact CPU view of the TurtleBot 4 task area; Gazebo GUI config allows sibling roots. -->
<window>
  <width>900</width><height>600</height>
  <dialog_on_exit>false</dialog_on_exit>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui><title>Warehouse</title><property key="state" type="string">docked</property><property key="showTitleBar" type="bool">false</property></gz-gui>
  <engine>ogre</engine><scene>scene</scene>
  <ambient_light>0.8 0.8 0.8</ambient_light>
  <background_color>0.3 0.7 0.9</background_color>
  <camera_pose>-5 2 3 0 0.42 -0.55</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui><property key="visible" type="bool">false</property><property key="state" type="string">floating</property></gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="View control">
  <gz-gui><property key="visible" type="bool">false</property><property key="state" type="string">floating</property></gz-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera tracking">
  <gz-gui><property key="visible" type="bool">false</property><property key="state" type="string">floating</property></gz-gui>
</plugin>
<plugin filename="WorldControl" name="World control">
  <gz-gui><title>Play / Pause</title><property key="state" type="string">floating</property><property key="width" type="double">200</property><property key="height" type="double">72</property><property key="showTitleBar" type="bool">false</property><anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></gz-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused><use_event>true</use_event>
</plugin>
<plugin filename="WorldStats" name="World statistics">
  <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">240</property><property key="height" type="double">80</property><property key="showTitleBar" type="bool">false</property><anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></gz-gui>
  <sim_time>true</sim_time><real_time_factor>true</real_time_factor>
</plugin>
<plugin filename="Screenshot" name="Screenshot">
  <gz-gui><property key="visible" type="bool">false</property><property key="state" type="string">floating</property></gz-gui>
</plugin>
