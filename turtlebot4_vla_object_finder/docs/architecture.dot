// Render: dot -Tsvg docs/architecture.dot -o docs/architecture.svg
digraph tb4 {
  rankdir=LR; bgcolor="white"; nodesep=0.35; ranksep=0.55;
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5", fontname="Helvetica", fontsize=11];
  edge [color="#555555", fontname="Helvetica", fontsize=9];

  browser [label="Browser\nhttp://127.0.0.1:8000\ncamera, instruction, progress, cancel", fillcolor="#fff6e0", color="#c08a1e"];

  subgraph cluster_app {
    label="application container (ROS 2 Jazzy)"; fontname="Helvetica-Bold"; fontsize=11; color="#4a6fa5"; style="rounded"; labelloc="b";
    web [label="vlm_nav_web\nFlask: /video_feed, /infer, /status, /cancel"];
    nav [label="vlm_nav navigator\naction /vlm_navigate\nsearch, verify, depth -> map goal"];
    nav2 [label="Nav2 + AMCL\nwarehouse map"];
  }
  subgraph cluster_sim {
    label="simulation container"; fontname="Helvetica-Bold"; fontsize=11; color="#3b8a5a"; style="rounded"; labelloc="b";
    gz [label="Gazebo Harmonic\nTurtleBot 4 in the warehouse", fillcolor="#eaf6ee", color="#3b8a5a"];
    bridge [label="ros_gz_bridge\nRGB, depth, CameraInfo, scan,\nodom, TF, clock, cmd_vel", fillcolor="#eaf6ee", color="#3b8a5a"];
  }
  subgraph cluster_inf {
    label="inference container"; fontname="Helvetica-Bold"; fontsize=11; color="#8a4fa5"; style="rounded"; labelloc="b";
    ollama [label="Ollama :8081\nqwen2.5vl:3b (GPU or CPU)", fillcolor="#f4ecf8", color="#8a4fa5"];
  }

  browser -> web [label="HTTP + MJPEG", dir=both];
  web -> nav [label="ROS action", dir=both];
  nav -> ollama [label="image + prompt -> box", dir=both];
  gz -> bridge [dir=both];
  bridge -> nav [label="RGB-D, TF"];
  bridge -> web [label="RGB"];
  bridge -> nav2 [label="scan, odom, TF"];
  nav -> nav2 [label="navigate_to_pose", dir=both];
  nav2 -> bridge [label="cmd_vel"];
}
