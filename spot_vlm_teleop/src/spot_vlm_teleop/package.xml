<?xml version="1.0"?>
<package format="3">
  <name>spot_vlm_teleop</name>
  <version>0.1.0</version>
  <description>Drive Spot from a web page, stream its camera, and ask an Ollama VLM about the image.</description>
  <maintainer email="qboticslabs@gmail.com">workshop</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>spot_inspection_sim</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
