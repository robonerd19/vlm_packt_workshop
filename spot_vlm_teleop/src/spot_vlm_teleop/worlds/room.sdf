<?xml version="1.0"?>
<!-- A 12 x 12 m room with eight objects around Spot, which spawns at the origin facing +x.
     Warehouse meshes: AWS RoboMaker Small Warehouse (MIT, see models/LICENSE). -->
<sdf version="1.9">
<world name="room">
  <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.75 0.8 1</background><shadows>false</shadows></scene>
  <gravity>0 0 -9.81</gravity>
  <light type="directional" name="sun"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
    <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular><direction>-0.3 0.2 -0.9</direction></light>

  <model name="floor"><static>true</static><link name="l">
    <visual name="v"><geometry><box><size>12 12 0.02</size></box></geometry>
      <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
    <collision name="c"><geometry><box><size>12 12 0.02</size></box></geometry></collision></link></model>
  <model name="wall_n"><static>true</static><pose>0 6 1.5 0 0 0</pose><link name="l">
    <visual name="v"><geometry><box><size>12 0.2 3</size></box></geometry>
      <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
    <collision name="c"><geometry><box><size>12 0.2 3</size></box></geometry></collision></link></model>
  <model name="wall_s"><static>true</static><pose>0 -6 1.5 0 0 0</pose><link name="l">
    <visual name="v"><geometry><box><size>12 0.2 3</size></box></geometry>
      <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
    <collision name="c"><geometry><box><size>12 0.2 3</size></box></geometry></collision></link></model>
  <model name="wall_e"><static>true</static><pose>6 0 1.5 0 0 0</pose><link name="l">
    <visual name="v"><geometry><box><size>0.2 12 3</size></box></geometry>
      <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
    <collision name="c"><geometry><box><size>0.2 12 3</size></box></geometry></collision></link></model>
  <model name="wall_w"><static>true</static><pose>-6 0 1.5 0 0 0</pose><link name="l">
    <visual name="v"><geometry><box><size>0.2 12 3</size></box></geometry>
      <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
    <collision name="c"><geometry><box><size>0.2 12 3</size></box></geometry></collision></link></model>

  <!-- Ahead of Spot -->
  <include><uri>model://aws_robomaker_warehouse_TrashCanC_01</uri><name>green_dumpster</name>
    <static>true</static><pose>4.2 0 0 0 0 1.5708</pose></include>
  <model name="red_barrel"><static>true</static><pose>3.3 2.2 0.45 0 0 0</pose><link name="l">
    <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
      <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
    <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision></link></model>
  <model name="blue_crate"><static>true</static><pose>3.3 -2.2 0.3 0 0 0.4</pose><link name="l">
    <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
      <material><ambient>0.1 0.25 0.8 1</ambient><diffuse>0.1 0.25 0.8 1</diffuse></material></visual>
    <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision></link></model>
  <!-- Left of Spot -->
  <include><uri>model://aws_robomaker_warehouse_DeskC_01</uri><name>desk</name>
    <static>true</static><pose>0 4.3 0 0 0 0</pose></include>
  <include><uri>model://aws_robomaker_warehouse_Bucket_01</uri><name>bucket</name>
    <static>true</static><pose>-2.5 3.5 0 0 0 0</pose></include>
  <!-- Right of Spot -->
  <include><uri>model://aws_robomaker_warehouse_PalletJackB_01</uri><name>pallet_jack</name>
    <static>true</static><pose>0.5 -3.8 0 0 0 0</pose></include>
  <!-- Behind Spot -->
  <include><uri>model://aws_robomaker_warehouse_ShelfE_01</uri><name>shelf</name>
    <static>true</static><pose>-5.2 0 0 0 0 1.5708</pose></include>
  <include><uri>model://aws_robomaker_warehouse_ClutteringA_01</uri><name>box_stack</name>
    <static>true</static><pose>-3 -3.5 0 0 0 0</pose></include>
</world>
</sdf>
