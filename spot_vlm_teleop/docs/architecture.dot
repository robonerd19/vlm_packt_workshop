// Render: dot -Tsvg docs/architecture.dot -o docs/architecture.svg
digraph teleop {
  rankdir=TB; bgcolor="white"; nodesep=0.4; ranksep=0.5; newrank=true;
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5", fontname="Helvetica", fontsize=11];
  edge [color="#555555", fontname="Helvetica", fontsize=9];

  browser [label="Browser\nhttp://127.0.0.1:8000\nlive video, drive pad,\nAsk, Detect, snapshot", fillcolor="#fff6e0", color="#c08a1e"];

  subgraph cluster_sim {
    label="simulation container"; fontname="Helvetica-Bold"; fontsize=11; color="#3b8a5a"; style="rounded"; labelloc="t";
    gz [label="Gazebo Harmonic\nSpot in the room (8 objects)\nfront camera 960x720 @ 5 Hz", fillcolor="#eaf6ee", color="#3b8a5a"];
    champ [label="CHAMP gait + ros2_control\n/cmd_vel -> leg joints", fillcolor="#eaf6ee", color="#3b8a5a"];
    bridge [label="ros_gz_bridge\n/inspection_camera/image", fillcolor="#eaf6ee", color="#3b8a5a"];
  }
  subgraph cluster_web {
    label="web container: spot_vlm_teleop/web_teleop.py"; fontname="Helvetica-Bold"; fontsize=11; color="#4a6fa5"; style="rounded"; labelloc="b";
    cvb [label="cv_bridge\nImage -> OpenCV BGR"];
    flask [label="Flask\n/video  /drive  /ask  /detect  /snapshot.jpg"];
    vlm [label="vlm.py\nask(): JPEG + base64 -> /api/chat\nparse_objects(), draw_objects()"];
    topics [label="/vlm/question, /vlm/answer\n/vlm/annotated (cv2_to_imgmsg)", shape=note, fillcolor="#ffffff"];
  }
  subgraph cluster_inf {
    label="inference container"; fontname="Helvetica-Bold"; fontsize=11; color="#8a4fa5"; style="rounded"; labelloc="b";
    ollama [label="Ollama :8081\nqwen2.5vl:3b", fillcolor="#f4ecf8", color="#8a4fa5"];
  }

  gz -> bridge [label="camera"];
  bridge -> cvb [label="sensor_msgs/Image"];
  cvb -> flask [label="frame"];
  flask -> browser [label="MJPEG + answers"];
  browser -> flask [label="hold-to-drive, questions"];
  flask -> vlm [dir=both];
  vlm -> ollama [label="image + prompt\n-> text or boxes", dir=both];
  flask -> champ [label="/cmd_vel (Twist)"];
  champ -> gz [label="joint commands", dir=both];
  vlm -> topics [style=dashed];
}
