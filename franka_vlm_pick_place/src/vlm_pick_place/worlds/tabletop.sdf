      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.3e-5</ixx><iyy>1.3e-5</iyy><izz>1.3e-5</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
