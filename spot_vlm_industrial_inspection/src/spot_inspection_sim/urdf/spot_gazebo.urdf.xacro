<?xml version="1.0"?>
<!-- Official RAI Spot model plus the Gazebo Harmonic pieces CHAMP needs:
     effort ros2_control, IMU, ground-truth odometry and an inspection camera. -->
<robot name="spot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_controllers" default="$(find spot_inspection_sim)/config/ros_control.yaml"/>

  <xacro:include filename="$(find spot_description)/urdf/spot_macro.xacro"/>
  <xacro:load_spot arm="false" feet="true" tf_prefix=""/>

  <!-- IMU at the body origin -->
  <link name="imu_link">
    <inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed"><parent link="body"/><child link="imu_link"/></joint>

  <!-- Inspection camera on the front rail, ahead of the body, tilted 6 degrees up toward gauges -->
  <link name="inspection_camera_link">
    <visual>
      <origin xyz="-0.03 0 0"/>
      <geometry><box size="0.06 0.12 0.06"/></geometry>
      <material name="cam_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="inspection_camera_joint" type="fixed">
    <parent link="front_rail"/><child link="inspection_camera_link"/>
    <origin xyz="0.22 0 0.05" rpy="0 -0.1 0"/>
  </joint>

  <xacro:macro name="leg_joints" params="leg">
    <xacro:joint_iface name="${leg}_hip_x" start="0.0"/>
    <xacro:joint_iface name="${leg}_hip_y" start="0.85"/>
    <xacro:joint_iface name="${leg}_knee" start="-1.54"/>
  </xacro:macro>
  <!-- start: CHAMP's IK stance for nominal_height 0.5, so Spot spawns standing instead of folding -->
  <xacro:macro name="joint_iface" params="name start">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${start}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="spot_gazebo" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:leg_joints leg="front_left"/>
    <xacro:leg_joints leg="front_right"/>
    <xacro:leg_joints leg="rear_left"/>
    <xacro:leg_joints leg="rear_right"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg robot_controllers)</parameters>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
    <!-- shortcut: the inspector navigates on Gazebo ground truth, not SLAM/Nav2; swap to AMCL+Nav2 for a real deployment. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>body</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_topic>/odom/ground_truth</odom_topic>
      <tf_topic>/odom/ground_truth_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="inspection_camera_link">
    <sensor name="inspection_camera" type="camera">
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>960</width><height>720</height></image>
        <clip><near>0.05</near><far>60</far></clip>
      </camera>
      <gz_frame_id>inspection_camera_link</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>5</update_rate>
      <topic>inspection_camera/image</topic>
    </sensor>
  </gazebo>

  <!-- Grippy feet, slippery legs (as in the Go2 CHAMP setup) -->
  <xacro:macro name="leg_friction" params="leg">
    <gazebo reference="${leg}_upper_leg"><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
    <gazebo reference="${leg}_lower_leg"><mu1>0.9</mu1><mu2>0.9</mu2><kp>100000.0</kp><kd>10.0</kd></gazebo>
  </xacro:macro>
  <xacro:leg_friction leg="front_left"/>
  <xacro:leg_friction leg="front_right"/>
  <xacro:leg_friction leg="rear_left"/>
  <xacro:leg_friction leg="rear_right"/>
</robot>
